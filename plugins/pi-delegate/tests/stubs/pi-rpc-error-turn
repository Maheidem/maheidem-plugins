#!/usr/bin/env bash
# Stub `pi --mode rpc --session-id <name> ...`: simulates a backend-failure turn.
while IFS= read -r line; do
  case "$line" in
    *'"type":"prompt"'*)
      echo '{"type":"response","command":"prompt","success":true}'
      echo '{"type":"agent_start"}'
      echo '{"type":"turn_start"}'
      echo '{"type":"agent_end","messages":[{"role":"assistant","content":[],"stopReason":"error","errorMessage":"500: model name=stub-model failed to load"}],"willRetry":false}'
      echo '{"type":"auto_retry_end","success":false,"attempt":3,"finalError":"500: model name=stub-model failed to load"}'
      echo '{"type":"agent_settled"}'
      ;;
    *'"type":"get_last_assistant_text"'*)
      echo '{"type":"response","command":"get_last_assistant_text","success":true,"data":{}}'
      ;;
    *'"type":"get_state"'*)
      echo '{"type":"response","command":"get_state","success":true,"data":{"sessionId":"stub-session-id","sessionFile":"/tmp/stub/session.jsonl","messageCount":2}}'
      ;;
    *'"type":"get_session_stats"'*)
      echo '{"type":"response","command":"get_session_stats","success":true,"data":{"userMessages":1,"assistantMessages":1,"totalMessages":2}}'
      ;;
  esac
done
exit 0
