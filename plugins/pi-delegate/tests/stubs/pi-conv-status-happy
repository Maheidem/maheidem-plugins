#!/usr/bin/env bash
# Stub `pi --mode rpc --session-id <name>`: answers get_state + get_session_stats.
while IFS= read -r line; do
  case "$line" in
    *'"type":"get_state"'*)
      echo '{"type":"response","command":"get_state","success":true,"data":{"sessionId":"stub-session-id","messageCount":4}}'
      ;;
    *'"type":"get_session_stats"'*)
      echo '{"type":"response","command":"get_session_stats","success":true,"data":{"userMessages":2,"assistantMessages":2,"totalMessages":4,"sessionFile":"/tmp/stub/session.jsonl","sessionId":"stub-session-id"}}'
      ;;
  esac
done
exit 0
