#!/usr/bin/env bash
# Stub pi: writes a valid ok marker, emits valid NDJSON with a final answer, exits 0.
marker="$(printf '%s\n' "$@" | grep -oE '[^ ]*pi-delegate-result-[0-9a-fA-F-]+\.json' | head -1)"
if [ -n "${PI_ARGS_OUT:-}" ]; then printf '%s\n' "$@" > "$PI_ARGS_OUT"; fi
echo '{"type":"agent_start"}'
echo '{"type":"agent_end","messages":[{"role":"assistant","stopReason":"stop","content":[{"type":"text","text":"real final answer"}]}]}'
if [ -n "$marker" ]; then
  printf '{"status":"ok","summary":"stub done","nextSteps":["a"]}\n' > "$marker"
fi
exit 0
