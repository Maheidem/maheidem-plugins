#!/usr/bin/env bash
# Stub pi: emits ~120KB of filler event lines, then normal RPC agent_end
# + get_last_assistant_text flow (no marker file — RPC only).
filler="$(printf 'x%.0s' {1..1000})"
while IFS= read -r line; do
  case "$line" in
    *'"type":"prompt"'*)
      for i in $(seq 1 120); do
        echo "{\"type\":\"message_update\",\"noise\":\"$filler\"}"
      done
      echo '{"type":"response","command":"prompt","success":true}'
      echo '{"type":"agent_start"}'
      echo '{"type":"turn_start"}'
      echo '{"type":"turn_end"}'
      echo '{"type":"agent_end","messages":[{"role":"assistant","stopReason":"stop","content":[{"type":"text","text":"big final answer"}]}]}'
      echo '{"type":"agent_settled"}'
      ;;
    *'"type":"get_last_assistant_text"'*)
      echo '{"type":"response","command":"get_last_assistant_text","success":true,"data":{"text":"big final answer"}}'
      ;;
    *'"type":"get_state"'*)
      echo '{"type":"response","command":"get_state","success":true,"data":{"sessionId":"stub-session-id","sessionFile":"/tmp/stub/session.jsonl","messageCount":2}}'
      ;;
    *'"type":"get_session_stats"'*)
      echo '{"type":"response","command":"get_session_stats","success":true,"data":{"userMessages":1,"assistantMessages":1,"totalMessages":2}}'
      ;;
  esac
done
exit 0
